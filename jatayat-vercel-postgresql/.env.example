# Recommended: paste the full PostgreSQL connection string from Neon or another provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional alternative if you do not use DATABASE_URL:
# PGHOST=your-host
# PGPORT=5432
# PGDATABASE=your-database
# PGUSER=your-user
# PGPASSWORD=your-password
# PGSSLMODE=require
